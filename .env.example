# Секреты. Рабочая копия: config/.env (в git не попадает).

# Логин Яндекса и ПАРОЛЬ ПРИЛОЖЕНИЯ (не основной пароль!):
# Яндекс ID → Безопасность → Пароли приложений → Календарь (CalDAV)
YANDEX_LOGIN=
YANDEX_APP_PASSWORD=

# Необязательно: PIN-код для входа в веб-интерфейс
HOMECAL_PIN=

# Порт на сервере
HOMECAL_PORT=8080
